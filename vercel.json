{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "uas-project": {
      "root": "UAS/uas-project",
      "framework": "nextjs"
    },
    "uas-project-backend": {
      "root": "UAS/uas-project-backend",
      "framework": "express"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "uas-project-backend" } },
    { "source": "/(.*)", "destination": { "service": "uas-project" } }
  ]
}
